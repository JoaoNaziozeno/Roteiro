# Tipo de Banco: "postgres" ou "sqlite"
DB_TYPE=postgres

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roteiro_ia
DB_USER=postgres
DB_PASSWORD=postgres

# Porta da aplicação web Python
PORT=8000

# Se postgres estiver inacessível, usar SQLite temporariamente (true/false)
FALLBACK_SQLITE=true
